#!/bin/bash
set -Eeuo pipefail

PROG="${0##*/}"

CONVERT_TO=""
NODE_NAME=""
NODE_TYPE=""
NUM_NODES=""
NAMESPACE=""
LIST_ONLY=0
SET_K8S="/usr/site/rcac/sbin/k8s-convert"
MARK_REASON="${MARK_REASON:-batch node selected for k8s conversion}"

# Discover default search domain for FQDN pings (may be empty)
NODE_SEARCH_DOMAIN="${NODE_SEARCH_DOMAIN:-$(hostname -d 2>/dev/null || true)}"

RES_NAME="k8s"
RES_USERS="root"
RES_ACCOUNTS="root"

# ---------------- Node eligibility tuning ----------------
# A node must have been idle at least this long before it can be taken.
MIN_IDLE_SECONDS="${MIN_IDLE_SECONDS:-600}"
# Reservations starting within this window make their nodes ineligible.
RES_LOOKAHEAD_SECONDS="${RES_LOOKAHEAD_SECONDS:-86400}"
# Optional pool guard: refuse to convert if doing so would leave fewer eligible
# idle nodes than the largest pending job needs. 0 disables the check.
PROTECT_LARGEST_PENDING="${PROTECT_LARGEST_PENDING:-0}"
# Slurm state flags that disqualify an otherwise-IDLE node.
EXCLUDE_STATE_FLAGS="DRAIN|DRAINING|DRAINED|DOWN|FAIL|FAILING|MAINT|PLANNED|RESERVED|REBOOT_REQUESTED|REBOOT_ISSUED|POWER_DOWN|POWERING_DOWN|POWERING_UP|POWERED_DOWN|NOT_RESPONDING|INVALID_REG|COMPLETING"

# ---------------- Preemption tuning ----------------
# Whole-node backfill jobs that may be preempted when nothing is idle. Only jobs
# matching BOTH the user and the account are ever touched.
PREEMPT_USER="${PREEMPT_USER:-x-ob}"
PREEMPT_ACCOUNT="${PREEMPT_ACCOUNT:-pur230002}"
# requeue = put the job back in the queue to run again later (default)
# cancel  = kill it outright
PREEMPT_MODE="${PREEMPT_MODE:-requeue}"
# SIGTERM the job and wait this long before requeue/cancel. 0 disables.
PREEMPT_GRACE_SECONDS="${PREEMPT_GRACE_SECONDS:-60}"
# Never preempt a job that has already run longer than this (0 = no limit).
# Youngest jobs are preempted first, so this protects long-running work.
PREEMPT_MAX_RUNTIME_SECONDS="${PREEMPT_MAX_RUNTIME_SECONDS:-0}"
# How long to wait for a preempted node to return to IDLE.
PREEMPT_DRAIN_TIMEOUT="${PREEMPT_DRAIN_TIMEOUT:-300}"
# Preemption is opt-in per invocation: --allow-preempt or PREEMPT_ENABLED=1.
ALLOW_PREEMPT="${PREEMPT_ENABLED:-0}"

# ---------------- Diagnostics ----------------

warn() { printf '%s\n' "$*" >&2; }
die()  { warn "ERROR: $*"; exit 1; }

# set -e aborts on any command that is not explicitly checked. Without this trap
# that abort is silent, which is the worst possible outcome half way through a
# conversion. Every deliberate failure path below prints its own message first;
# this only catches the ones nobody thought of.
on_err() {
    local rc="$1" line="$2" cmd="$3"
    warn "ERROR: ${PROG}: unchecked command failed (rc=${rc}) at line ${line}: ${cmd}"
}
trap 'on_err "$?" "$LINENO" "$BASH_COMMAND"' ERR

# Fails early and by name rather than "command not found" mid-mutation.
require_cmd() {
    local c missing=()
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    if ((${#missing[@]})); then
        die "required command(s) not found: ${missing[*]}"
    fi
}

usage() {
    cat <<EOF
Usage: $0 --set <k8s|batch> [--node-name <name> | (--node-type a|b|g --num-nodes <num>)] [--namespace <ns>]
       $0 --list [--node-type a|b|g | --node-name <name>]

    --set         k8s | batch   (required unless --list)
    --node-name   Convert a single node by name
    --node-type   Node type prefix (a|b|g) to select from (required with --num-nodes)
    --num-nodes   Number of nodes to convert (required with --node-type)
    --namespace   Namespace tag to apply on converted nodes (label/taint as <ns>=true)
    --list        Read-only: show which Slurm nodes are viable for conversion and
                  why the rest are not. Changes nothing.
    --allow-preempt
                  When too few nodes are idle, preempt single-node backfill jobs
                  owned by ${PREEMPT_USER}/${PREEMPT_ACCOUNT} to free some. Off by default.
    --help        This message

Environment overrides (both modes):
    MIN_IDLE_SECONDS         Minimum idle time before a node is viable (default 600)
    RES_LOOKAHEAD_SECONDS    Treat reservations starting within this window as
                             blocking (default 86400)
    PROTECT_LARGEST_PENDING  1 = refuse to convert if it would leave fewer viable
                             nodes than the largest pending job needs (default 0)
    MARK_REASON              Slurm Reason recorded on a node drained for
                             conversion; shows up in 'sinfo -R'
                             (default "batch node selected for k8s conversion")

Required for --set batch:
    PASSWORD                 racadm password used to power cycle the node

Preemption (only with --allow-preempt or PREEMPT_ENABLED=1):
    PREEMPT_USER             Job owner eligible for preemption (default x-ob)
    PREEMPT_ACCOUNT          Account eligible for preemption (default pur230002)
    PREEMPT_MODE             requeue (default) | cancel
    PREEMPT_GRACE_SECONDS    SIGTERM then wait this long before acting (default 60)
    PREEMPT_MAX_RUNTIME_SECONDS
                             Never preempt a job running longer than this (0 = no limit)
    PREEMPT_DRAIN_TIMEOUT    Seconds to wait for a preempted node to go IDLE (default 300)
EOF
    exit 1
}

# Drains the node with a Reason, so the note stays visible in 'sinfo -R' for as
# long as the node is out of the batch pool: a reservation carries no per-node
# explanation of its own. Slurm only keeps a Reason on a node that is out of
# service, which is why this drains rather than annotating in place. The
# reservation is still the real claim, so a failure here is reported but does
# not stop the conversion.
mark_node() {
    local node="$1"
    echo "Marking $node"
    if ! /usr/bin/scontrol update "nodename=${node}" state=drain \
            reason="${MARK_REASON}"; then
        warn "WARN: could not drain ${node}; continuing"
    fi
    return 0
}

# Undoes mark_node. Every rollback that hands a marked node back to Slurm must
# call this: releasing the reservation alone leaves the node DRAIN, and because
# DRAIN is in EXCLUDE_STATE_FLAGS it would never be selected again either, so
# the node falls silently out of both pools. Safe on a node that has since been
# claimed by a job -- resume clears the drain flag without touching the job.
# Best effort like mark_node: a rollback path must not abort on cleanup.
unmark_node() {
    local node="$1"
    echo "Unmarking $node"
    if ! /usr/bin/scontrol update "nodename=${node}" state=resume; then
        warn "WARN: could not clear the drain on ${node}; resume it by hand"
    fi
    return 0
}

is_node_reachable() {
    local node="$1"
    echo "PING CHECK (short): $node"
    if ping -c1 -W1 -q "$node" >/dev/null 2>&1; then
        echo "PING OK (short): $node"
        return 0
    fi
    if [[ -n "$NODE_SEARCH_DOMAIN" ]]; then
        local fqdn="${node}.${NODE_SEARCH_DOMAIN}"
        echo "PING CHECK (fqdn): $fqdn"
        if ping -c1 -W1 -q "$fqdn" >/dev/null 2>&1; then
            echo "PING OK (fqdn): $fqdn"
            return 0
        fi
    fi
    echo "PING FAIL: $node"
    return 1
}

# ---------------- Slurm query helpers ----------------

# Expanding a hostlist that scontrol cannot parse must never look like "no
# nodes": every caller decides for itself whether that is fatal.
expand_hostlist() {
    local hl="$1" out
    if [[ -z "$hl" || "$hl" == "(null)" || "$hl" == "N/A" ]]; then
        return 0
    fi
    if ! out="$(/usr/bin/scontrol show hostnames "$hl" 2>&1)"; then
        warn "WARN: could not expand hostlist '${hl}': ${out}"
        return 1
    fi
    printf '%s\n' "$out"
}

# ---------------- Slurm reservation helpers ----------------

# 0 = exists, 1 = definitely absent, 2 = could not tell. "Could not tell" must
# never be read as "absent": that sends res_add_nodes down the create path and
# would rebuild the reservation from scratch around a single node.
res_exists() {
    local out
    if out="$(/usr/bin/scontrol show reservation "$RES_NAME" 2>&1)"; then
        return 0
    fi
    if printf '%s\n' "$out" | grep -qiE 'not found|invalid reservation|no reservation'; then
        return 1
    fi
    warn "WARN: could not determine whether reservation ${RES_NAME} exists: ${out}"
    return 2
}

res_get_nodes_hostlist() {
    # Must match the Nodes= key specifically. Splitting the whole record on '='
    # and taking field 2 yields the ReservationName value instead, which then
    # gets merged back in as a phantom node.
    local out
    if ! out="$(/usr/bin/scontrol --oneliner show reservation "$RES_NAME" 2>&1)"; then
        warn "WARN: 'scontrol show reservation ${RES_NAME}' failed: ${out}"
        return 1
    fi
    printf '%s\n' "$out" | grep -oE '(^| )Nodes=[^ ]+' | head -n1 | cut -d= -f2- || true
}

# Returns non-zero if the current membership could not be read. Callers must not
# treat that as "the reservation is empty": rewriting it from a truncated list
# would release nodes that are actively running Kubernetes.
res_get_nodes_expanded() {
    local hostlist
    hostlist="$(res_get_nodes_hostlist)" || return 1
    if [[ -z "${hostlist:-}" ]]; then
        return 0
    fi
    expand_hostlist "$hostlist" || return 1
}

res_set_nodes_from_array() {
    local nodes=("$@")
    if ((${#nodes[@]} == 0)); then
        echo "Reservation $RES_NAME would be empty; deleting it."
        if ! /usr/bin/scontrol delete reservation "$RES_NAME"; then
            warn "ERROR: could not delete reservation ${RES_NAME}"
            return 1
        fi
        return 0
    fi

    mapfile -t uniq_sorted < <(printf "%s\n" "${nodes[@]}" | awk 'NF' | sort -u)

    # join with commas just cause
    local csv
    csv="$(IFS=, ; echo "${uniq_sorted[*]}")"

    # compress with hostlist that already exists
    local compressed
    if ! compressed="$(/usr/bin/scontrol show hostlist "$csv" 2>&1)"; then
        warn "ERROR: could not compress node list '${csv}': ${compressed}"
        return 1
    fi

    echo "Updating reservation $RES_NAME nodes to: $compressed"
    # IGNORE_JOBS lets the reservation cover a node whose job we are about to
    # preempt; without it scontrol refuses because the node is busy.
    if ! /usr/bin/scontrol update ReservationName="$RES_NAME" Nodes="$compressed" Users="$RES_USERS" Accounts="$RES_ACCOUNTS" Flags=IGNORE_JOBS; then
        warn "ERROR: could not update reservation ${RES_NAME} to: ${compressed}"
        return 1
    fi
}

res_create_with_nodes() {
    local nodes_csv="$1"
    echo "Creating reservation $RES_NAME with nodes: $nodes_csv"
    if ! /usr/bin/scontrol create reservation \
        ReservationName="$RES_NAME" \
        StartTime=now Duration=INFINITE \
        Users=root Accounts=root \
        Flags=IGNORE_JOBS \
        Nodes="$nodes_csv"; then
        warn "ERROR: could not create reservation ${RES_NAME} with nodes: ${nodes_csv}"
        return 1
    fi
}


res_add_nodes() {
    local add_nodes=("$@")

    if ((${#add_nodes[@]} == 0)); then
        return 0
    fi

    local exists=0
    res_exists || exists=$?
    if (( exists == 2 )); then
        warn "ERROR: cannot tell whether reservation ${RES_NAME} exists; refusing to touch it"
        return 1
    fi
    if (( exists == 1 )); then
        # Create with provided nodes
        local csv
        csv="$(IFS=, ; echo "${add_nodes[*]}")"
        res_create_with_nodes "$csv" || return 1
        return 0
    fi

    # Merge with existing. A read failure here is fatal: continuing would rewrite
    # the reservation with only the new nodes and hand every node already running
    # Kubernetes back to the Slurm scheduler.
    local existing_raw
    if ! existing_raw="$(res_get_nodes_expanded)"; then
        warn "ERROR: could not read current members of reservation ${RES_NAME}; refusing to rewrite it"
        return 1
    fi

    local existing=()
    if [[ -n "$existing_raw" ]]; then
        mapfile -t existing <<<"$existing_raw"
    fi

    local merged=("${existing[@]}" "${add_nodes[@]}")
    res_set_nodes_from_array "${merged[@]}" || return 1
}


res_remove_nodes() {
    # Remove nodes given as args; delete reservation if empty afterwards
    local del=("$@")
    if ((${#del[@]} == 0)); then
        return 0
    fi
    local exists=0
    res_exists || exists=$?
    if (( exists == 2 )); then
        warn "ERROR: cannot tell whether reservation ${RES_NAME} exists; refusing to touch it"
        return 1
    fi
    if (( exists == 1 )); then
        echo "Reservation $RES_NAME does not exist; nothing to remove."
        return 0
    fi

    local existing_raw
    if ! existing_raw="$(res_get_nodes_expanded)"; then
        warn "ERROR: could not read current members of reservation ${RES_NAME}; refusing to rewrite or delete it"
        return 1
    fi

    local existing=()
    if [[ -n "$existing_raw" ]]; then
        mapfile -t existing <<<"$existing_raw"
    fi

    # If reservation has no nodes, delete it
    if ((${#existing[@]} == 0)); then
        echo "Reservation $RES_NAME has no nodes; deleting."
        if ! /usr/bin/scontrol delete reservation "$RES_NAME"; then
            warn "ERROR: could not delete empty reservation ${RES_NAME}"
            return 1
        fi
        return 0
    fi

    declare -A to_del=()
    for n in "${del[@]}"; do to_del["$n"]=1; done

    new_list=()
    for n in "${existing[@]}"; do
        if [[ -z "${to_del[$n]:-}" ]]; then
            new_list+=("$n")
        fi
    done

    if ((${#new_list[@]} == 0)); then
        echo "Last node(s) removed; deleting reservation $RES_NAME."
        if ! /usr/bin/scontrol delete reservation "$RES_NAME"; then
            warn "ERROR: could not delete reservation ${RES_NAME}"
            return 1
        fi
    else
        res_set_nodes_from_array "${new_list[@]}" || return 1
    fi
}

# -----------------------------------------------------------

# ---------------- Node eligibility helpers ----------------

# Nodes the Slurm scheduler has already earmarked for a pending job, emitted as
# "<node> <jobid>". Backfill publishes its plan as SchedNodes on the pending job;
# those nodes sit IDLE on purpose while the job's other resources free up.
#
# A squeue failure is reported as a failure rather than as an empty plan: an
# empty plan silently promotes earmarked nodes to "viable".
planned_nodes() {
    local raw
    if ! raw="$(/usr/bin/squeue --noheader --states=PENDING --Format=JobID:24,SchedNodes:2000 2>&1)"; then
        warn "ERROR: 'squeue --states=PENDING' failed: ${raw}"
        return 1
    fi

    printf '%s\n' "$raw" \
      | while read -r jid hl _; do
            if [[ -z "${hl:-}" || "$hl" == "(null)" || "$hl" == "N/A" ]]; then
                continue
            fi
            while read -r n; do
                [[ -n "$n" ]] && printf '%s %s\n' "$n" "$jid"
            done < <(expand_hostlist "$hl" || true)
        done
}

# Nodes covered by a reservation that is active now or starts within the
# lookahead window, emitted as "<node> <reservation>". Our own k8s reservation
# is excluded.
reserved_nodes() {
    local now horizon raw
    now="$(date +%s)"
    horizon=$(( now + RES_LOOKAHEAD_SECONDS ))

    if ! raw="$(/usr/bin/scontrol --oneliner show reservation 2>&1)"; then
        warn "ERROR: 'scontrol show reservation' failed: ${raw}"
        return 1
    fi

    printf '%s\n' "$raw" \
      | awk '
          {
            delete f
            n = split($0, t, " ")
            for (i = 1; i <= n; i++) {
                p = index(t[i], "=")
                if (p > 1) {
                    k = substr(t[i], 1, p - 1); v = substr(t[i], p + 1)
                    if (!(k in f)) f[k] = v
                }
            }
            if (f["ReservationName"] == "" || f["Nodes"] == "" || f["Nodes"] == "(null)") next
            print f["ReservationName"] "|" f["StartTime"] "|" f["EndTime"] "|" f["Nodes"]
          }' \
      | while IFS='|' read -r name start end nodes; do
            if [[ "$name" == "$RES_NAME" ]]; then
                continue
            fi
            local s e
            s="$(date -d "$start" +%s 2>/dev/null || echo 0)"
            e="$(date -d "$end" +%s 2>/dev/null || echo 9999999999)"
            if (( e < now )) || (( s > horizon )); then
                continue
            fi
            while read -r n; do
                [[ -n "$n" ]] && printf '%s %s\n' "$n" "$name"
            done < <(expand_hostlist "$nodes" || true)
        done
}

# Running jobs owned by the preemptible user+account, emitted as
#   <elapsed_seconds>|<jobid>|<numnodes>|<nodelist>
# sorted youngest first, so preemption costs the least compute.
preemptible_jobs() {
    local now raw
    now="$(date +%s)"

    if ! raw="$(/usr/bin/squeue --noheader --states=RUNNING \
        --user="$PREEMPT_USER" --account="$PREEMPT_ACCOUNT" \
        --Format=JobID:24,NumNodes:12,StartTime:26,NodeList:2000 2>&1)"; then
        warn "ERROR: 'squeue --states=RUNNING --user=${PREEMPT_USER}' failed: ${raw}"
        return 1
    fi

    printf '%s\n' "$raw" \
      | while read -r jid nn st nl _; do
            if [[ -z "${nl:-}" || "$nl" == "(null)" || "$nl" == "N/A" ]]; then
                continue
            fi
            local start elapsed
            start="$(date -d "$st" +%s 2>/dev/null || echo 0)"
            if (( start == 0 )); then
                continue
            fi
            elapsed=$(( now - start ))
            if (( elapsed < 0 )); then
                elapsed=0
            fi
            if (( PREEMPT_MAX_RUNTIME_SECONDS > 0 && elapsed > PREEMPT_MAX_RUNTIME_SECONDS )); then
                continue
            fi
            printf '%s|%s|%s|%s\n' "$elapsed" "$jid" "$nn" "$nl"
        done \
      | sort -t'|' -k1,1n
}

# Flattens preemptible_jobs to "<node> <jobid> <runtime> <numnodes>" for the
# node report. Multi-node jobs are carried through so the report can explain why
# they are not preemptible, rather than leaving the node looking plain busy.
preemptible_node_map() {
    local elapsed jid nn nl human n jobs_raw
    if ! jobs_raw="$(preemptible_jobs)"; then
        return 1
    fi
    if [[ -z "$jobs_raw" ]]; then
        return 0
    fi
    while IFS='|' read -r elapsed jid nn nl; do
        [[ -n "${jid:-}" ]] || continue
        human="$(fmt_duration "$elapsed")"
        while read -r n; do
            [[ -n "$n" ]] && printf '%s %s %s %s\n' "$n" "$jid" "$human" "$nn"
        done < <(expand_hostlist "$nl" || true)
    done <<<"$jobs_raw"
}

# The preemptible workload is single-node by construction. Preempting a
# multi-node job would destroy several nodes' worth of work to satisfy a
# one-node request, so those jobs are reported and skipped, never preempted.
job_is_single_node() {
    [[ "${1:-0}" == "1" ]]
}

# Largest node count requested by any pending job (0 if none). Returns non-zero
# if the queue could not be read, so the pool guard can refuse to guess.
largest_pending_nodecount() {
    local raw
    if ! raw="$(/usr/bin/squeue --noheader --states=PENDING --Format=NumNodes:20 2>&1)"; then
        warn "WARN: 'squeue --states=PENDING' failed: ${raw}"
        return 1
    fi
    printf '%s\n' "$raw" \
      | awk '{ gsub(/[^0-9].*$/, "", $1); if ($1 + 0 > max) max = $1 + 0 } END { print max + 0 }'
}

# Judges every node matching the (optional) name prefix and prints one
# pipe-delimited record per node:
#
#     <node>|<state>|<idle_seconds>|<OK|PREEMPT|SKIP>|<reason>
#
# A node is OK only if it is base-state IDLE with no disqualifying flag, has
# been idle at least MIN_IDLE_SECONDS, is not earmarked for a pending job, and
# is not in a current or imminent reservation. A busy node is PREEMPT when the
# job holding it belongs to the preemptible user+account and nothing else
# (reservation, backfill plan) disqualifies the node. This is the single source
# of truth for both --list and the conversion paths.
#
# Returns non-zero if any input could not be collected. A partial report would
# mark nodes viable that the missing input would have excluded, so callers must
# treat failure as "convert nothing".
node_report() {
    local prefix="${1:-}"
    local now planned_file reserved_file preempt_file
    local nodes_raw planned_raw reserved_raw preempt_raw
    now="$(date +%s)"

    if ! nodes_raw="$(/usr/bin/scontrol --oneliner show nodes 2>&1)"; then
        warn "ERROR: 'scontrol show nodes' failed: ${nodes_raw}"
        return 1
    fi
    if ! planned_raw="$(planned_nodes)"; then
        warn "ERROR: could not determine which nodes are planned for pending jobs"
        return 1
    fi
    if ! reserved_raw="$(reserved_nodes)"; then
        warn "ERROR: could not determine which nodes are reserved"
        return 1
    fi
    if ! preempt_raw="$(preemptible_node_map)"; then
        warn "ERROR: could not determine which nodes hold preemptible jobs"
        return 1
    fi

    planned_file="$(mktemp)" || { warn "ERROR: mktemp failed"; return 1; }
    reserved_file="$(mktemp)" || { warn "ERROR: mktemp failed"; rm -f "$planned_file"; return 1; }
    preempt_file="$(mktemp)" || { warn "ERROR: mktemp failed"; rm -f "$planned_file" "$reserved_file"; return 1; }
    trap 'rm -f "$planned_file" "$reserved_file" "$preempt_file"' RETURN

    printf '%s\n' "$planned_raw"  | awk 'NF' | sort -u -k1,1 > "$planned_file"
    printf '%s\n' "$reserved_raw" | awk 'NF' | sort -u -k1,1 > "$reserved_file"
    printf '%s\n' "$preempt_raw"  | awk 'NF' | sort -u -k1,1 > "$preempt_file"

    printf '%s\n' "$nodes_raw" \
      | awk -v prefix="$prefix" -v planned="$planned_file" -v reserved="$reserved_file" \
            -v preempt="$preempt_file" -v puser="$PREEMPT_USER" -v pacct="$PREEMPT_ACCOUNT" \
            -v bad="$EXCLUDE_STATE_FLAGS" '
          BEGIN {
            while ((getline line < planned) > 0)  { split(line, a, " "); if (a[1] != "") pjob[a[1]] = a[2] }
            while ((getline line < reserved) > 0) { split(line, a, " "); if (a[1] != "") pres[a[1]] = a[2] }
            while ((getline line < preempt) > 0) {
                split(line, a, " ")
                if (a[1] != "") { pmjob[a[1]] = a[2]; pmage[a[1]] = a[3]; pmcnt[a[1]] = a[4] }
            }
          }
          {
            delete f
            n = split($0, t, " ")
            for (i = 1; i <= n; i++) {
                p = index(t[i], "=")
                if (p > 1) {
                    k = substr(t[i], 1, p - 1); v = substr(t[i], p + 1)
                    if (!(k in f)) f[k] = v
                }
            }
            name = f["NodeName"]; state = f["State"]
            if (name == "" || state == "") next
            if (prefix != "" && index(name, prefix) != 1) next

            verdict = "OK"; reason = "-"
            m = split(state, sf, "+")
            if (sf[1] != "IDLE") {
                if ((name in pmjob) && pmcnt[name] + 0 == 1) {
                    verdict = "PREEMPT"
                    reason = "job " pmjob[name] " (" puser "/" pacct ") running " pmage[name]
                } else if (name in pmjob) {
                    verdict = "SKIP"
                    reason = "job " pmjob[name] " spans " pmcnt[name] " nodes; only single-node jobs are preemptible"
                } else {
                    verdict = "SKIP"; reason = "not idle (" sf[1] ")"
                }
            } else {
                for (i = 2; i <= m; i++) {
                    if (sf[i] ~ ("^(" bad ")$")) { verdict = "SKIP"; reason = "state flag " sf[i]; break }
                }
            }
            # A node the backfill scheduler is counting on, or one inside a
            # reservation, is off limits even if a preemptible job holds it.
            if (verdict != "SKIP" && (name in pjob)) {
                verdict = "SKIP"; reason = "planned for pending job " pjob[name]
            }
            if (verdict != "SKIP" && (name in pres)) {
                verdict = "SKIP"; reason = "reservation " pres[name]
            }

            lb = f["LastBusyTime"]
            if (lb == "") lb = "Unknown"
            print name "|" state "|" lb "|" verdict "|" reason
          }' \
      | while IFS='|' read -r name state lb verdict reason; do
            local lb_epoch age
            if [[ "$lb" == "Unknown" || -z "$lb" ]]; then
                # No timestamp to judge by; assume it just crossed the threshold.
                age="$MIN_IDLE_SECONDS"
            else
                lb_epoch="$(date -d "$lb" +%s 2>/dev/null || echo 0)"
                if (( lb_epoch == 0 )); then
                    age="$MIN_IDLE_SECONDS"
                else
                    age=$(( now - lb_epoch ))
                fi
            fi
            if (( age < 0 )); then
                age=0
            fi
            if [[ "$verdict" == "OK" ]] && (( age < MIN_IDLE_SECONDS )); then
                verdict="SKIP"; reason="idle only ${age}s (< ${MIN_IDLE_SECONDS}s)"
            fi
            printf '%s|%s|%s|%s|%s\n' "$name" "$state" "$age" "$verdict" "$reason"
        done
}

# Prints eligible node names, longest-idle first. Fails if the report does.
select_eligible_nodes() {
    node_report "${1:-}" \
      | awk -F'|' '$4 == "OK" { print $3 "\t" $1 }' \
      | sort -k1,1nr | cut -f2
}

# Base state of a node with all flags stripped ("IDLE" from "IDLE+RESERVED").
# Returns non-zero if Slurm could not be asked, which is not the same as a node
# that is not idle.
node_base_state() {
    local out st
    if ! out="$(/usr/bin/scontrol --oneliner show node "$1" 2>&1)"; then
        warn "WARN: 'scontrol show node $1' failed: ${out}"
        return 1
    fi
    st="$(printf '%s\n' "$out" | grep -oE '(^| )State=[^ ]+' | head -n1 | cut -d= -f2 || true)"
    printf '%s' "${st%%+*}"
}

# Waits for a preempted node to finish COMPLETING and come back IDLE.
wait_for_node_idle() {
    local node="$1" deadline st
    deadline=$(( $(date +%s) + PREEMPT_DRAIN_TIMEOUT ))
    while (( $(date +%s) < deadline )); do
        if st="$(node_base_state "$node")" && [[ "$st" == "IDLE" ]]; then
            return 0
        fi
        sleep 5
    done
    return 1
}

job_is_requeueable() {
    local out v
    if ! out="$(/usr/bin/scontrol --oneliner show job "$1" 2>&1)"; then
        warn "WARN: 'scontrol show job $1' failed: ${out}"
        # Unknown is not a licence to requeue something that cannot be requeued.
        return 1
    fi
    v="$(printf '%s\n' "$out" | grep -oE '(^| )Requeue=[0-9]+' | head -n1 | cut -d= -f2 || true)"
    [[ "${v:-1}" != "0" ]]
}

# Preempts one single-node job and waits for its node to come free.
# Returns 0 and leaves the node IDLE and reserved; returns 1 having changed
# nothing (or having released the reservation again) on any failure.
preempt_job() {
    local jid="$1" node="$2"

    if [[ "$PREEMPT_MODE" != "cancel" ]] && ! job_is_requeueable "$jid"; then
        echo "PREEMPT: job $jid is not requeueable (Requeue=0 or unreadable); skipping. Set PREEMPT_MODE=cancel to kill it instead." >&2
        return 1
    fi

    # Claim the node *before* freeing it. IGNORE_JOBS lets the reservation cover
    # a busy node, so the scheduler cannot hand it to another job in the window
    # between the job exiting and k8s-convert running.
    echo "PREEMPT: reserving $node ahead of preempting job $jid" >&2
    if ! res_add_nodes "$node" >&2; then
        echo "PREEMPT: could not reserve $node; leaving job $jid alone" >&2
        return 1
    fi

    if (( PREEMPT_GRACE_SECONDS > 0 )); then
        echo "PREEMPT: sending TERM to job $jid, ${PREEMPT_GRACE_SECONDS}s grace" >&2
        /usr/bin/scancel --signal=TERM --full "$jid" >&2 \
            || echo "PREEMPT: TERM to job $jid failed; continuing to ${PREEMPT_MODE}" >&2
        sleep "$PREEMPT_GRACE_SECONDS"
    fi

    if [[ "$PREEMPT_MODE" == "cancel" ]]; then
        echo "PREEMPT: cancelling job $jid ($PREEMPT_USER/$PREEMPT_ACCOUNT) on $node" >&2
        if ! /usr/bin/scancel "$jid" >&2; then
            echo "PREEMPT: scancel failed for job $jid; releasing reservation on $node" >&2
            res_remove_nodes "$node" >&2 \
                || echo "PREEMPT: could not release $node from reservation $RES_NAME; remove it by hand" >&2
            return 1
        fi
    else
        echo "PREEMPT: requeueing job $jid ($PREEMPT_USER/$PREEMPT_ACCOUNT) on $node" >&2
        if ! /usr/bin/scontrol requeue "$jid" >&2; then
            echo "PREEMPT: requeue failed for job $jid; releasing reservation on $node" >&2
            res_remove_nodes "$node" >&2 \
                || echo "PREEMPT: could not release $node from reservation $RES_NAME; remove it by hand" >&2
            return 1
        fi
    fi

    if ! wait_for_node_idle "$node"; then
        echo "PREEMPT: $node did not return to IDLE within ${PREEMPT_DRAIN_TIMEOUT}s" >&2
        # The job is already gone. Holding the node in the reservation as well
        # would leave it idle in neither pool, so hand it back to Slurm.
        echo "PREEMPT: releasing the reservation on $node" >&2
        res_remove_nodes "$node" >&2 \
            || echo "PREEMPT: could not release $node from reservation $RES_NAME; remove it by hand" >&2
        return 1
    fi

    echo "PREEMPT: $node is now IDLE" >&2
}

# Preempts youngest-first until <want> nodes matching <prefix> are free.
# Prints the freed node names. Returns non-zero only when the job list itself
# could not be read; freeing fewer nodes than asked is reported by the caller.
preempt_free_nodes() {
    local want="$1" prefix="${2:-}"
    local got=0 freed_all=()
    local elapsed jid nn nl node jobs_raw

    if ! jobs_raw="$(preemptible_jobs)"; then
        echo "PREEMPT: cannot list preemptible jobs; not preempting anything" >&2
        return 1
    fi
    if [[ -z "$jobs_raw" ]]; then
        echo "PREEMPT: no running ${PREEMPT_USER}/${PREEMPT_ACCOUNT} jobs to preempt" >&2
        return 0
    fi

    while IFS='|' read -r elapsed jid nn nl; do
        [[ -n "${jid:-}" ]] || continue
        if (( got >= want )); then
            break
        fi

        if ! job_is_single_node "$nn"; then
            echo "PREEMPT: skipping job $jid (spans ${nn} nodes; only single-node jobs are preemptible)" >&2
            continue
        fi

        node="$(expand_hostlist "$nl" 2>/dev/null | head -n1 || true)"
        if [[ -z "$node" ]]; then
            echo "PREEMPT: job $jid has no expandable node list ('$nl'); skipping" >&2
            continue
        fi

        if [[ -n "$prefix" && "$node" != "$prefix"* ]]; then
            echo "PREEMPT: skipping job $jid (node $node is outside type '$prefix')" >&2
            continue
        fi

        # Confirm the node is usable before destroying work to get it.
        if ! is_node_reachable "$node" >&2; then
            echo "PREEMPT: skipping job $jid ($node is unreachable)" >&2
            continue
        fi

        echo "PREEMPT: selecting job $jid (running $(fmt_duration "$elapsed")) to free $node" >&2
        if preempt_job "$jid" "$node"; then
            freed_all+=("$node")
            got=$(( got + 1 ))
        fi
    done <<<"$jobs_raw"

    if ((${#freed_all[@]})); then
        printf '%s\n' "${freed_all[@]}"
    fi
}

# Frees one specific node by preempting whichever preemptible job holds it.
preempt_free_named_node() {
    local node="$1"
    local elapsed jid nn nl jnode found=0 hit_jid="" hit_nn="" jobs_raw

    if ! jobs_raw="$(preemptible_jobs)"; then
        echo "PREEMPT: cannot list preemptible jobs; not preempting anything" >&2
        return 1
    fi

    while IFS='|' read -r elapsed jid nn nl; do
        [[ -n "${jid:-}" ]] || continue
        jnode="$(expand_hostlist "$nl" 2>/dev/null | grep -xF "$node" || true)"
        if [[ -n "$jnode" ]]; then
            hit_jid="$jid"; hit_nn="$nn"; found=1
            break
        fi
    done <<<"$jobs_raw"

    if (( found == 0 )); then
        echo "PREEMPT: no preemptible job ($PREEMPT_USER/$PREEMPT_ACCOUNT) is holding $node" >&2
        return 1
    fi

    if ! job_is_single_node "$hit_nn"; then
        echo "PREEMPT: job $hit_jid holds $node but spans ${hit_nn} nodes; only single-node jobs are preemptible" >&2
        return 1
    fi

    preempt_job "$hit_jid" "$node"
}

# Human-readable dump of every node and why it is or is not viable.
list_viable_nodes() {
    local prefix="${1:-}" report ok_count preempt_count total largest
    if ! report="$(node_report "$prefix")"; then
        warn "ERROR: could not build the node report; nothing to show"
        return 1
    fi

    printf '%-16s %-24s %12s  %-7s %s\n' "NODE" "STATE" "IDLE" "VERDICT" "REASON"
    if [[ -n "$report" ]]; then
        printf '%s\n' "$report" \
          | sort -t'|' -k4,4 -k3,3nr \
          | while IFS='|' read -r name state age verdict reason; do
                printf '%-16s %-24s %12s  %-7s %s\n' \
                    "$name" "$state" "$(fmt_duration "$age")" "$verdict" "$reason"
            done
    fi

    total=0; ok_count=0; preempt_count=0
    if [[ -n "$report" ]]; then
        total="$(printf '%s\n' "$report" | wc -l | tr -d ' ')"
        ok_count="$(printf '%s\n' "$report" | awk -F'|' '$4 == "OK"' | wc -l | tr -d ' ')"
        preempt_count="$(printf '%s\n' "$report" | awk -F'|' '$4 == "PREEMPT"' | wc -l | tr -d ' ')"
    fi

    echo
    echo "Viable now: ${ok_count} of ${total} node(s)${prefix:+ matching prefix '${prefix}'}"
    echo "Thresholds: MIN_IDLE_SECONDS=${MIN_IDLE_SECONDS} RES_LOOKAHEAD_SECONDS=${RES_LOOKAHEAD_SECONDS}"

    echo "Preemptible: ${preempt_count} node(s) held by ${PREEMPT_USER}/${PREEMPT_ACCOUNT}"
    if (( ALLOW_PREEMPT > 0 )); then
        echo "Preemption: ENABLED, mode=${PREEMPT_MODE}, grace=${PREEMPT_GRACE_SECONDS}s"
    else
        echo "Preemption: disabled (pass --allow-preempt or set PREEMPT_ENABLED=1), would use mode=${PREEMPT_MODE}"
    fi

    if ! largest="$(largest_pending_nodecount)"; then
        echo "Largest pending job: unknown (could not read the pending queue)."
        return 0
    fi
    if (( largest > 0 )); then
        echo "Largest pending job requests ${largest} node(s)."
        if (( PROTECT_LARGEST_PENDING > 0 )); then
            echo "PROTECT_LARGEST_PENDING=1: at most $(( ok_count - largest < 0 ? 0 : ok_count - largest )) node(s) may be converted."
        else
            echo "PROTECT_LARGEST_PENDING=0: pool guard disabled."
        fi
    fi
}

# Renders a second count as e.g. "2d3h" / "45m". No spaces: the result is also
# embedded in the reason column.
fmt_duration() {
    local s="${1:-0}"
    if (( s >= 86400 )); then
        printf '%dd%dh' $(( s / 86400 )) $(( (s % 86400) / 3600 ))
    elif (( s >= 3600 )); then
        printf '%dh%dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
    elif (( s >= 60 )); then
        printf '%dm' $(( s / 60 ))
    else
        printf '%ds' "$s"
    fi
}

# Re-checks nodes after they were added to the reservation, to catch a job that
# started in the gap between selection and reservation.
verify_still_idle() {
    local rc=0 n st
    for n in "$@"; do
        if ! st="$(node_base_state "$n")"; then
            echo "RACE: could not read state of $n; treating it as unsafe" >&2
            rc=1
            continue
        fi
        if [[ "$st" != "IDLE" ]]; then
            echo "RACE: $n is now State=${st:-unknown}; Slurm claimed it after selection" >&2
            rc=1
        fi
    done
    return $rc
}

# ---------------- batch (k8s -> Slurm) helpers ----------------

k8s_node_exists() {
    kubectl get node "$1" >/dev/null 2>&1
}

# Drains and deletes the node from Kubernetes. A node that is already absent is
# not an error; a drain we could not complete is, because deleting it anyway
# would strand running pods.
remove_node_from_k8s() {
    local node="$1"
    if ! k8s_node_exists "$node"; then
        echo "WARN: $node is not registered in Kubernetes; skipping drain/delete" >&2
        return 0
    fi

    echo "Draining $node from Kubernetes"
    if ! kubectl drain --ignore-daemonsets --delete-emptydir-data --force "$node"; then
        warn "ERROR: 'kubectl drain $node' failed; not deleting the node"
        return 1
    fi

    if ! kubectl delete node "$node"; then
        if k8s_node_exists "$node"; then
            warn "ERROR: 'kubectl delete node $node' failed and the node is still registered"
            return 1
        fi
        echo "WARN: delete reported an error but $node is gone from Kubernetes" >&2
    fi
    return 0
}

powercycle_node() {
    local node="$1"
    echo "Power cycling ${node} via mgmt/racadm"
    if ! ssh mgmt /opt/dell/srvadmin/sbin/racadm -r "${node}.iron" --nocertwarn -u root -p "$PASSWORD" serveraction powercycle; then
        warn "ERROR: power cycle failed for ${node}"
        return 1
    fi
    echo "Server power operation initiated successfully for ${node}"
}

slurm_resume_node() {
    local node="$1"
    echo "SLURM RESUME: /usr/bin/scontrol update nodename=${node} state=resume"
    if ! /usr/bin/scontrol update "nodename=${node}" state=resume; then
        warn "ERROR: could not resume ${node} in Slurm"
        return 1
    fi
    # Cosmetic: some Slurm versions reject Reason= on an already-resumed node.
    /usr/bin/scontrol update "nodename=${node}" Reason="k8s-node reverted back to batch; ready for use." \
        || warn "WARN: could not set the Reason note on ${node} (it is resumed regardless)"
    return 0
}

# Full k8s -> batch conversion of one node. Each step gates the next: a node we
# could not power cycle is never handed back to Slurm, and the caller leaves it
# in the k8s reservation so no batch job lands on a half-converted machine.
revert_node_to_batch() {
    local node="$1"
    echo "Converting $node back to batch"

    if ! remove_node_from_k8s "$node"; then
        warn "SKIP: ${node} was not removed from Kubernetes; leaving it reserved and out of Slurm"
        return 1
    fi
    if ! powercycle_node "$node"; then
        warn "SKIP: ${node} was not power cycled; NOT resuming it in Slurm and keeping it in reservation ${RES_NAME}"
        return 1
    fi
    if ! slurm_resume_node "$node"; then
        warn "SKIP: ${node} stays in reservation ${RES_NAME} until it is resumed by hand"
        return 1
    fi
    return 0
}

# -----------------------------------------------------------

# -------- arg parsing --------
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --set)
            [[ $# -ge 2 ]] || { warn "Error: --set requires a value"; usage; }
            CONVERT_TO="$2"; shift 2 ;;
        --node-name)
            [[ $# -ge 2 ]] || { warn "Error: --node-name requires a value"; usage; }
            NODE_NAME="$2";  shift 2 ;;
        --node-type)
            [[ $# -ge 2 ]] || { warn "Error: --node-type requires a value"; usage; }
            NODE_TYPE="$2";  shift 2 ;;
        --num-nodes)
            [[ $# -ge 2 ]] || { warn "Error: --num-nodes requires a value"; usage; }
            NUM_NODES="$2";  shift 2 ;;
        --namespace)
            [[ $# -ge 2 ]] || { warn "Error: --namespace requires a value"; usage; }
            NAMESPACE="$2";  shift 2 ;;
        --list)       LIST_ONLY=1;     shift ;;
        --allow-preempt) ALLOW_PREEMPT=1; shift ;;
        --help)       usage ;;
        *)            warn "Error: unknown argument '$key'"; usage ;;
    esac
done

# Node and namespace values are interpolated into pdsh/ssh command lines, so
# they are checked for shape before anything is run with them.
if [[ -n "$NODE_NAME" && ! "$NODE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "invalid --node-name '${NODE_NAME}'"
fi
if [[ -n "$NODE_TYPE" && ! "$NODE_TYPE" =~ ^[A-Za-z][A-Za-z0-9]*$ ]]; then
    die "invalid --node-type '${NODE_TYPE}' (expected a name prefix such as a, b or g)"
fi
if [[ -n "$NAMESPACE" && ! "$NAMESPACE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "invalid --namespace '${NAMESPACE}'"
fi

require_cmd /usr/bin/scontrol /usr/bin/squeue awk sort date mktemp

# Read-only inspection mode: report and exit before any validation or mutation.
if (( LIST_ONLY )); then
    list_viable_nodes "${NODE_NAME:-${NODE_TYPE}}" || exit 1
    exit 0
fi

[[ -z "$CONVERT_TO" ]] && usage

if [[ -n "$NODE_NAME" && ( -n "$NODE_TYPE" || -n "$NUM_NODES" ) ]]; then
    echo "Error: If --node-name is selected, the other two parameters cannot be selected." >&2
    usage
fi

if [[ -n "$NODE_TYPE" && -z "$NUM_NODES" ]] || [[ -z "$NODE_TYPE" && -n "$NUM_NODES" ]]; then
    echo "Error: Both --node-type and --num-nodes must be provided together." >&2
    usage
fi

if [[ -z "$NODE_NAME" && -z "$NODE_TYPE" ]]; then
    echo "Error: either --node-name, or --node-type with --num-nodes, is required." >&2
    usage
fi

if [[ -n "$NUM_NODES" && ! "$NUM_NODES" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --num-nodes must be a positive integer (got '${NUM_NODES}')." >&2
    usage
fi
# -----------------------------

# Everything the chosen mode needs, checked before the first mutation.
case $CONVERT_TO in
    k8s )
        require_cmd pdsh ping
        ;;
    batch )
        require_cmd kubectl ssh
        # Only the --node-type/--num-nodes path picks nodes at random.
        [[ -n "$NODE_NAME" ]] || require_cmd shuf
        # Checked up front: reaching it unset after the node has already been
        # drained and deleted loses the node from both Kubernetes and Slurm.
        [[ -n "${PASSWORD:-}" ]] \
            || die "PASSWORD is not set; it is required to power cycle nodes with racadm. Export PASSWORD before running --set batch."
        ;;
esac

case $CONVERT_TO in
    k8s )
        # Multi-node
        if [[ -z "$NODE_NAME" ]]; then
            if ! candidates_raw="$(select_eligible_nodes "$NODE_TYPE")"; then
                die "could not determine eligible nodes; converting nothing"
            fi
            candidates=()
            if [[ -n "$candidates_raw" ]]; then
                mapfile -t candidates <<<"$candidates_raw"
            fi

            # The pool guard is judged on genuinely idle nodes, before any
            # preemption: if a big job is already starved, do not make it worse.
            if (( PROTECT_LARGEST_PENDING > 0 )); then
                if ! largest="$(largest_pending_nodecount)"; then
                    die "PROTECT_LARGEST_PENDING=1 but the pending queue could not be read; refusing to convert"
                fi
                if (( largest > 0 && ${#candidates[@]} - NUM_NODES < largest )); then
                    echo "Refusing to convert ${NUM_NODES} node(s): would leave $(( ${#candidates[@]} - NUM_NODES )) eligible idle node(s), below the largest pending job (${largest} nodes)" >&2
                    exit 1
                fi
            fi

            # Nothing idle? Fall back to preempting single-node backfill jobs.
            preempted=()
            if ((${#candidates[@]} < NUM_NODES)) && (( ALLOW_PREEMPT > 0 )); then
                deficit=$(( NUM_NODES - ${#candidates[@]} ))
                echo "Only ${#candidates[@]} idle node(s) of type '${NODE_TYPE}'; preempting up to ${deficit} more from ${PREEMPT_USER}/${PREEMPT_ACCOUNT} (mode=${PREEMPT_MODE})"
                freed_raw=""
                if ! freed_raw="$(preempt_free_nodes "$deficit" "$NODE_TYPE")"; then
                    echo "Preemption could not run" >&2
                fi
                if [[ -n "$freed_raw" ]]; then
                    mapfile -t preempted <<<"$freed_raw"
                fi
                if ((${#preempted[@]})); then
                    echo "Preemption freed ${#preempted[@]} node(s): ${preempted[*]}"
                    candidates+=("${preempted[@]}")
                else
                    echo "Preemption freed no nodes" >&2
                fi
            fi

            if ((${#candidates[@]} == 0)); then
                echo "No eligible idle nodes of type '${NODE_TYPE}' found (need IDLE, no PLANNED/RESERVED/DRAIN flag, idle >= ${MIN_IDLE_SECONDS}s, not planned for a pending job)" >&2
                if (( ALLOW_PREEMPT == 0 )); then
                    echo "Run with --allow-preempt to preempt ${PREEMPT_USER}/${PREEMPT_ACCOUNT} backfill jobs; 'node-convert --list' shows what that would free." >&2
                fi
                exit 1
            fi

            reachable=()
            for n in "${candidates[@]}"; do
                if is_node_reachable "$n"; then
                    echo "PING PASS: selecting $n"
                    reachable+=("$n")
                    if ((${#reachable[@]} >= NUM_NODES)); then
                        break
                    fi
                else
                    echo "PING SKIP: $n not reachable"
                fi
            done

            if ((${#reachable[@]} < NUM_NODES)); then
                echo "Only found ${#reachable[@]} reachable nodes (requested ${NUM_NODES})" >&2
                # Nothing will be converted, so do not strand preempted nodes in
                # the reservation where Slurm can never schedule them again.
                if ((${#preempted[@]})); then
                    echo "Releasing preempted node(s) back to Slurm: ${preempted[*]}" >&2
                    res_remove_nodes "${preempted[@]}" >&2 \
                        || warn "WARN: could not release ${preempted[*]} from reservation ${RES_NAME}; remove them by hand"
                fi
                exit 1
            fi

            printf "%s\n" "${reachable[@]}"
            for node in "${reachable[@]}"; do
                mark_node "$node"
            done

            nodes_csv="$(IFS=, ; echo "${reachable[*]}")"

            # ---- reservation: add nodes ----
            if ! res_add_nodes "${reachable[@]}"; then
                for node in "${reachable[@]}"; do
                    unmark_node "$node"
                done
                if ((${#preempted[@]})); then
                    echo "Releasing preempted node(s) back to Slurm: ${preempted[*]}" >&2
                    res_remove_nodes "${preempted[@]}" >&2 \
                        || warn "WARN: could not release ${preempted[*]} from reservation ${RES_NAME}; remove them by hand"
                fi
                die "could not reserve ${reachable[*]}; nothing was converted"
            fi

            # The reservation is the real claim; confirm nothing landed first.
            if ! verify_still_idle "${reachable[@]}"; then
                echo "Rolling back reservation membership for: ${reachable[*]}" >&2
                res_remove_nodes "${reachable[@]}" \
                    || warn "WARN: rollback failed; remove ${reachable[*]} from reservation ${RES_NAME} by hand"
                for node in "${reachable[@]}"; do
                    unmark_node "$node"
                done
                exit 1
            fi

            # Pass namespace via env so k8s-convert/k8s-register can use it
            rc=0
            pdsh -w "$nodes_csv" "env NAMESPACE='${NAMESPACE}' $SET_K8S" || rc=$?
            if (( rc != 0 )); then
                echo "pdsh failed with rc=$rc" >&2
                # pdsh reports one rc for the whole set, so some nodes may be
                # half converted. They stay reserved and drained (out of Slurm's
                # reach) on purpose; check the pdsh output above to see which
                # failed.
                echo "Node(s) ${reachable[*]} remain drained and in reservation ${RES_NAME}. Inspect them, then run '${PROG} --set batch --node-name <node>' on any that did not convert." >&2
                exit $rc
            fi
            for node in "${reachable[@]}"; do
                echo "$node"
            done

        # Single node
        else
            if ! report="$(node_report "$NODE_NAME")"; then
                die "could not judge $NODE_NAME; converting nothing"
            fi
            verdict="$(printf '%s\n' "$report" | awk -F'|' -v n="$NODE_NAME" '$1 == n { print $4; exit }')"
            if [[ -z "$verdict" ]]; then
                die "$NODE_NAME is not a known Slurm node"
            fi
            if [[ "$verdict" == "PREEMPT" && $ALLOW_PREEMPT -gt 0 ]]; then
                echo "$NODE_NAME is held by a preemptible ${PREEMPT_USER}/${PREEMPT_ACCOUNT} job; preempting it (mode=${PREEMPT_MODE})"
                if ! preempt_free_named_node "$NODE_NAME"; then
                    echo "Could not free $NODE_NAME by preemption. Please pick another node." >&2
                    exit 1
                fi
            elif [[ "$verdict" != "OK" ]]; then
                echo "$NODE_NAME is not eligible: it must be IDLE with no PLANNED/RESERVED/DRAIN flag, idle for >= ${MIN_IDLE_SECONDS}s, and not planned for a pending job. Please pick another node." >&2
                printf '%s\n' "$report" | awk -F'|' -v n="$NODE_NAME" '$1 == n { print "  reason: " $5 }' >&2
                if [[ "$verdict" == "PREEMPT" ]]; then
                    echo "  (pass --allow-preempt to preempt the job holding it)" >&2
                fi
                exit 1
            fi
            if ! is_node_reachable "$NODE_NAME"; then
                echo "$NODE_NAME is not reachable (ping failed). Please pick another node." >&2
                exit 1
            fi
            echo "PING PASS: selecting $NODE_NAME"
            mark_node "$NODE_NAME"

            # ---- reservation: add node ----
            if ! res_add_nodes "$NODE_NAME"; then
                unmark_node "$NODE_NAME"
                die "could not reserve ${NODE_NAME}; nothing was converted"
            fi

            if ! verify_still_idle "$NODE_NAME"; then
                echo "Rolling back reservation membership for: $NODE_NAME" >&2
                res_remove_nodes "$NODE_NAME" \
                    || warn "WARN: rollback failed; remove ${NODE_NAME} from reservation ${RES_NAME} by hand"
                unmark_node "$NODE_NAME"
                exit 1
            fi

            rc=0
            pdsh -w "$NODE_NAME" "env NAMESPACE='${NAMESPACE}' $SET_K8S" || rc=$?
            if (( rc != 0 )); then
                echo "pdsh failed with rc=$rc for $NODE_NAME" >&2
                echo "$NODE_NAME remains drained and in reservation ${RES_NAME}. Inspect it, then run '${PROG} --set batch --node-name ${NODE_NAME}' to hand it back to Slurm." >&2
                exit $rc
            fi

            echo "$NODE_NAME"
        fi
    ;;
    batch )
        # Multi-node
        if [[ -z "$NODE_NAME" ]]; then
            if ! k8s_nodes_raw="$(kubectl get nodes --no-headers 2>&1)"; then
                die "'kubectl get nodes' failed: ${k8s_nodes_raw}"
            fi

            nodes=()
            selected="$(printf '%s\n' "$k8s_nodes_raw" \
                | awk -v nt="$NODE_TYPE" '$1 ~ "^" nt "[0-9]{3}$" {print $1}' \
                | shuf -n "${NUM_NODES}")"
            if [[ -n "$selected" ]]; then
                mapfile -t nodes <<<"$selected"
            fi

            if ((${#nodes[@]} == 0)); then
                echo "No Kubernetes nodes matched type '${NODE_TYPE}'" >&2
                exit 1
            fi
            if ((${#nodes[@]} < NUM_NODES)); then
                echo "WARN: only ${#nodes[@]} node(s) of type '${NODE_TYPE}' are in Kubernetes (requested ${NUM_NODES}); reverting those" >&2
            fi

            echo "Converting these nodes back to batch: ${nodes[*]}"

            reverted=()
            failed=()
            for node in "${nodes[@]}"; do
                if revert_node_to_batch "$node"; then
                    reverted+=("$node")
                else
                    failed+=("$node")
                fi
            done

            # ---- reservation: remove nodes (and delete res if last) ----
            # Only the nodes that made it all the way back to Slurm; the rest
            # stay reserved so no batch job lands on them.
            if ((${#reverted[@]})); then
                res_remove_nodes "${reverted[@]}" \
                    || die "reverted ${reverted[*]} but could not update reservation ${RES_NAME}; remove them by hand"
            fi

            if ((${#failed[@]})); then
                die "failed to revert: ${failed[*]} (still held by reservation ${RES_NAME}; see the errors above)"
            fi

        # Single node
        else
            if ! revert_node_to_batch "$NODE_NAME"; then
                die "failed to revert ${NODE_NAME} (still held by reservation ${RES_NAME}; see the errors above)"
            fi

            # ---- reservation: remove node (and delete res if last) ----
            res_remove_nodes "$NODE_NAME" \
                || die "reverted ${NODE_NAME} but could not update reservation ${RES_NAME}; remove it by hand"
        fi
    ;;
    * )
        usage
    ;;
esac
